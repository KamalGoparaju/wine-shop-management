// Combined Database Schema for Wine Shop Management Monorepo
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH SERVICE MODELS
// ==========================================

enum Role {
  ADMIN
  STAFF
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(STAFF)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userShops UserShop[]

  @@map("users")
}

model Shop {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userShops UserShop[]

  @@map("shops")
}

model UserShop {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  shopId    String   @map("shop_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
  @@map("user_shops")
}

// ==========================================
// INVENTORY SERVICE MODELS
// ==========================================

enum BottleStatus {
  IN_STOCK
  SOLD
  DAMAGED
  RETURNED
  ADJUSTED
}

enum StockEntryStatus {
  COMPLETED
  CANCELLED
}

model Brand {
  id                String             @id @default(uuid())
  serialNo          Int?               @unique @map("serial_no")
  name              String             @unique
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  products          Product[]
  rates             BrandSizeRate[]
  dailyStockRecords DailyStockRecord[]

  @@map("brands")
}

model Size {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  volumeMl          Int?               @map("volume_ml")
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rates             BrandSizeRate[]
  dailyStockRecords DailyStockRecord[]

  @@map("sizes")
}

model BrandSizeRate {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  sizeId    String   @map("size_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  size      Size     @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  rate      Decimal  @map("rate") @db.Decimal(10, 2)
  shopId    String?  @map("shop_id")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, sizeId, shopId])
  @@map("brand_size_rates")
}

model DailyStockRecord {
  id           String   @id @default(uuid())
  shopId       String   @map("shop_id")
  businessDate DateTime @map("business_date") @db.Date
  brandId      String   @map("brand_id")
  sizeId       String   @map("size_id")
  brand        Brand    @relation(fields: [brandId], references: [id])
  size         Size     @relation(fields: [sizeId], references: [id])
  openingStock Int      @default(0) @map("opening_stock")
  indentStock  Int      @default(0) @map("indent_stock")
  totalStock   Int      @default(0) @map("total_stock")
  closingStock Int      @default(0) @map("closing_stock")
  saleCount    Int      @default(0) @map("sale_count")
  bottleRate   Decimal  @map("bottle_rate") @db.Decimal(10, 2)
  saleAmount   Decimal  @map("sale_amount") @db.Decimal(10, 2)
  extraAmount  Decimal  @default(0) @map("extra_amount") @db.Decimal(10, 2)
  status       String   @default("DRAFT")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopId, businessDate, brandId, sizeId])
  @@index([shopId, businessDate])
  @@map("daily_stock_records")
}

model Product {
  id                 String       @id @default(uuid())
  brandId            String       @map("brand_id")
  brand              Brand        @relation(fields: [brandId], references: [id])
  name               String
  bottleVolume       String       @map("bottle_volume")
  bottlesPerBox      Int          @map("bottles_per_box")
  defaultBottlePrice Decimal      @map("default_bottle_price") @db.Decimal(10, 2)
  defaultBoxPrice    Decimal      @map("default_box_price") @db.Decimal(10, 2)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  stockEntries       StockEntry[]
  bottles            Bottle[]

  @@unique([brandId, name, bottleVolume])
  @@map("products")
}

model StockEntry {
  id            String           @id @default(uuid())
  shopId        String?          @map("shop_id")
  productId     String           @map("product_id")
  product       Product          @relation(fields: [productId], references: [id])
  numberOfBoxes Int              @map("number_of_boxes")
  bottlesPerBox Int              @map("bottles_per_box")
  totalBottles  Int              @map("total_bottles")
  boxPrice      Decimal          @map("box_price") @db.Decimal(10, 2)
  bottlePrice   Decimal          @map("bottle_price") @db.Decimal(10, 2)
  status        StockEntryStatus @default(COMPLETED)
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  boxes         Box[]
  bottles       Bottle[]

  @@map("stock_entries")
}

model Box {
  id           String     @id @default(uuid())
  stockEntryId String     @map("stock_entry_id")
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  boxNumber    Int        @map("box_number")
  createdAt    DateTime   @default(now()) @map("created_at")
  bottles      Bottle[]

  @@unique([stockEntryId, boxNumber])
  @@map("boxes")
}

model Bottle {
  id               String            @id @default(uuid())
  serialNumber     String            @unique @map("serial_number")
  boxId            String            @map("box_id")
  box              Box               @relation(fields: [boxId], references: [id], onDelete: Cascade)
  stockEntryId     String            @map("stock_entry_id")
  stockEntry       StockEntry        @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  productId        String            @map("product_id")
  product          Product           @relation(fields: [productId], references: [id])
  bottlePrice      Decimal           @map("bottle_price") @db.Decimal(10, 2)
  status           BottleStatus      @default(IN_STOCK)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  stockAdjustments StockAdjustment[]

  @@index([serialNumber])
  @@index([status])
  @@index([productId, status])
  @@map("bottles")
}

model StockAdjustment {
  id             String       @id @default(uuid())
  bottleId       String       @map("bottle_id")
  bottle         Bottle       @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  previousStatus BottleStatus @map("previous_status")
  newStatus      BottleStatus @map("new_status")
  reason         String
  adjustedBy     String       @map("adjusted_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("stock_adjustments")
}

// ==========================================
// SALES SERVICE MODELS
// ==========================================

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

model Sale {
  id            String        @id @default(uuid())
  shopId        String?       @map("shop_id")
  invoiceNumber String        @unique @map("invoice_number")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  soldBy        String        @map("sold_by")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  items         SaleItem[]

  @@map("sales")
}

model Expense {
  id            String        @id @default(uuid())
  shopId        String        @map("shop_id")
  businessDate  DateTime      @map("business_date") @db.Date
  category      String
  description   String
  amount        Decimal       @map("amount") @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  recipient     String?
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([shopId, businessDate])
  @@map("expenses")
}

model DailyClosing {
  id                        String   @id @default(uuid())
  shopId                    String   @map("shop_id")
  businessDate              DateTime @map("business_date") @db.Date
  totalBusiness             Decimal  @map("total_business") @db.Decimal(10, 2)
  totalBottlesSold          Int      @map("total_bottles_sold")
  totalBottlesRemaining      Int      @map("total_bottles_remaining")
  onlineCollection          Decimal  @map("online_collection") @db.Decimal(10, 2)
  offlineCollection         Decimal  @map("offline_collection") @db.Decimal(10, 2)
  totalCollected            Decimal  @map("total_collected") @db.Decimal(10, 2)
  totalExpenses             Decimal  @map("total_expenses") @db.Decimal(10, 2)
  finalAmount               Decimal  @map("final_amount") @db.Decimal(10, 2)
  collectionDifference      Decimal  @map("collection_difference") @db.Decimal(10, 2)
  extraAmountInformational  Decimal  @default(0) @map("extra_amount_informational") @db.Decimal(10, 2)
  status                    String   @default("CLOSED")
  closedBy                  String   @map("closed_by")
  closedAt                  DateTime @default(now()) @map("closed_at")
  notes                     String?
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([shopId, businessDate])
  @@index([shopId])
  @@map("daily_closings")
}

model SaleItem {
  id                 String   @id @default(uuid())
  saleId             String   @map("sale_id")
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  bottleSerialNumber String   @map("bottle_serial_number")
  productId          String   @map("product_id")
  unitPrice          Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([bottleSerialNumber])
  @@map("sale_items")
}
